GATEWAY_KEYS=replace-with-a-long-random-key
# 每个实例在控制面单独设置 OpenCode Zen Key，不要把它写入此全局配置
# 设置后 /metrics 也需要 Bearer 鉴权
ADMIN_TOKEN=replace-with-another-long-random-token
# 控制面访问实例管理 API 的内网密钥；生产环境建议与 ADMIN_TOKEN 不同
INSTANCE_ADMIN_TOKEN=replace-with-an-internal-instance-token
PROXY_REFRESH_INTERVAL=30s
# 按顺序尝试公网 IP 探测地址，并按实际出口 IP 去重
PROXY_PROBE_URL=https://api.ipify.org,https://ifconfig.me/ip,https://www.cloudflare.com/cdn-cgi/trace
PROXY_PROBE_TIMEOUT=10s
PROXY_PROBE_CONCURRENCY=8
# 0 表示自动使用各实例的并发上限
TARGET_EGRESS_SLOTS=0
# 429/5xx 或首输出前断流时，最多再尝试两个尚未使用的不同出口
MAX_RETRIES=2
REQUEST_TIMEOUT=5m
# 流式请求在该时间内必须出现文本、推理、工具调用或 Responses 完成事件；0 关闭
STREAM_FIRST_OUTPUT_TIMEOUT=20s
# 首输出前断流或超时的出口对当前模型至少冷却多久；0 关闭额外冷却
STREAM_FAILURE_COOLDOWN=10m
COOLDOWN_BASE=5s
COOLDOWN_MAX=60s
OPENCODE_CLIENT=desktop
# Zen CPA 请求头；User-Agent 最终为 opencode/${OPENCODE_VERSION}
OPENCODE_VERSION=1.18.16
OPENCODE_REFERER=https://opencode.ai/
OPENCODE_TITLE=opencode
FREE_MODELS_ONLY=true
# DeepSeek V4 Flash 未明确指定思考模式时关闭推理，避免推理耗尽 max_tokens 后 content 为空
# DeepSeek V4 Flash 默认同时注入 thinking.disabled 与 reasoning_effort=none
DISABLE_THINKING_BY_DEFAULT=true
# 显式开启推理时的最低总输出预算；0 表示关闭保护
MIN_THINKING_MAX_TOKENS=8192
# 多实例 Compose 的 Mihomo 容器由控制台管理；通常无需修改以下默认值
MIHOMO_CONTAINER=opencode-gateway-mihomo
MIHOMO_CONFIG_DIR=/mihomo-config
MIHOMO_API_URL=http://mihomo:9090
# 每个实例至少需要一个独立槽位；槽位可在订阅节点之间动态换线
MIHOMO_MAX_SLOTS=64
# 可选：宿主机映射端口；默认控制面 13338、API 13337
CONTROL_HOST_PORT=13338
API_HOST_PORT=13337
# false：存在代理实例时，内置路由器不再把请求分配给直连实例
DIRECT_FALLBACK=false
# 兼容旧配置名：NGINX_HOST_PORT、NGINX_DIRECT_FALLBACK
